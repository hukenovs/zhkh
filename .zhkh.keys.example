# Опционально — VLM-разбор квитанций (CLI: --summarize, бот: кнопка «Суммаризировать»).
openrouter:
  api_key: "..."
  # OCR-grade VLM. По умолчанию — nemotron-nano-12b-v2-vl:free: специализированная
  # VL-модель NVIDIA, лидер OCRBench v2 среди бесплатных на OpenRouter.
  model: "nvidia/nemotron-nano-12b-v2-vl:free"
  # Список бесплатных меняется! Актуальные :free с поддержкой картинок —
  # https://openrouter.ai/models?max_price=0 (фильтр Input modalities: image).
  # На момент написания доступны бесплатно:
  #   google/gemma-4-31b-it:free               — общая мультимодалка, слабее на OCR
  #   google/gemma-4-26b-a4b-it:free
  # Платные, если нужна максимальная точность OCR:
  #   qwen/qwen3.7-plus, qwen/qwen3-vl-32b-instruct, qwen/qwen2.5-vl-72b-instruct.
  # PDF отдаётся модели как есть — она сама читает документ; промпт в src/zhkh/prompts.txt.

# Опционально — для Telegram-бота (run_bot.py / zhkh-bot).
# token: получить у @BotFather.
# allowed_chat_ids: бот отвечает только этим chat_id (узнать свой — у @userinfobot).
telegram:
  token: "123456789:AA..."
  allowed_chat_ids:
    - 11111111
