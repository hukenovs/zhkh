mosenergosbyt:
  login: "user@example.com"
  password: "..."

mosvodokanal:
  login: "user@example.com"
  password: "..."

etalonuk:
  login: "+79991234567"
  password: "..."

# Опционально — VLM-разбор квитанций (CLI: --summarize, бот: кнопка «Суммаризировать»).
openrouter:
  api_key: "..."
  # OCR-grade VLM. По умолчанию — qwen2.5-vl-72b:free: в бенчмарках по извлечению
  # данных из документов обгоняет даже специализированный mistral-ocr.
  model: "qwen/qwen2.5-vl-72b-instruct:free"
  # Другие бесплатные VLM (:free) на выбор — см. https://openrouter.ai/models?max_price=0
  #   qwen/qwen2.5-vl-32b-instruct:free        — полегче, тоже сильный OCR
  #   mistralai/mistral-small-3.1-24b-instruct:free
  #   meta-llama/llama-3.2-11b-vision-instruct:free
  #   google/gemma-3-27b-it:free               — слабее на OCR
  #   nvidia/nemotron-nano-... (если доступна) — топ OCRBench среди бесплатных
  # Платные с лучшим OCR: qwen/qwen3-vl-32b-instruct, mistralai/mistral-ocr.
  # Движок разбора PDF: pdf-text (бесплатно, для цифровых PDF — дефолт),
  # mistral-ocr (платно, для сканов), native (отдать PDF самой модели).
  pdf_engine: "pdf-text"

# Опционально — для Telegram-бота (run_bot.py / zhkh-bot).
# token: получить у @BotFather.
# allowed_chat_ids: бот отвечает только этим chat_id (узнать свой — у @userinfobot).
telegram:
  token: "123456789:AA..."
  allowed_chat_ids:
    - 11111111
